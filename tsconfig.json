{
  // Node v26 executa `.ts` nativamente, mas só faz TYPE-STRIPPING: ele apaga as
  // anotações e roda. Nada aqui jamais foi verificado por um typechecker — 550
  // testes verdes não dizem uma palavra sobre corretude de tipos.
  //
  // Este arquivo existe para fechar esse buraco. `noEmit` porque o produto roda
  // do fonte; o compilador é usado como verificador, nunca como gerador.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Os imports do projeto usam extensão `.ts` explícita, que é o que o Node
    // exige para executar sem build. Sem esta flag o tsc recusa cada import.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["es2023", "dom"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "spike/**/*.ts"],
  "exclude": ["node_modules", "**/dist/**"]
}
